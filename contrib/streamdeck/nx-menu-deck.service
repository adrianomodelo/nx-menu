[Unit]
Description=Mirror the nx-menu launcher on an Elgato Stream Deck MK.2
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/nx-menu-deck
Environment=NX_MENU_CONF=%h/.config/nx-menu/apps.tsv
# The systemd --user PATH does not include ~/.local/bin, so without this the
# deck comes up, renders every key correctly, and every press does nothing —
# see README.md's "The service's PATH does not include ~/.local/bin".
Environment=NX_MENU_BIN=%h/.local/bin/nx-menu
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.cache/nx-menu-deck.log
StandardError=append:%h/.cache/nx-menu-deck.log

[Install]
WantedBy=default.target
